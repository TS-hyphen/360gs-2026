{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/360gs/install-manifest.lock.schema.json",
  "title": "360GS Installer Lock Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "generatedAtUtc",
    "profiles",
    "packs",
    "artifacts"
  ],
  "properties": {
    "manifestVersion": {
      "type": "string",
      "pattern": "^v[0-9]+(\\.[0-9]+)*$"
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "preview-min",
          "research-full",
          "offline-preview"
        ]
      },
      "uniqueItems": true
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "profiles",
        "packs",
        "source",
        "sha256",
        "install"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "install": {
          "$ref": "#/$defs/install"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "url",
            "offline"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "targetSubdir"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "extract-zip",
            "extract-tar-gz",
            "copy-file",
            "run-installer"
          ]
        },
        "targetSubdir": {
          "type": "string",
          "minLength": 1
        },
        "installerArgs": {
          "type": "string"
        },
        "expectedRelativePath": {
          "type": "string"
        }
      }
    }
  }
}
